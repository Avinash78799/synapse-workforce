  "components": {
    "schemas": {
      "ApprovalDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "denied"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "reason"
        ],
        "title": "ApprovalDecision"
      },
      "Autonomy": {
        "properties": {
          "level": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Level"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "level",
          "reason"
        ],
        "title": "Autonomy"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Knowledge": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "Knowledge"
      },
      "Lifecycle": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "active",
              "draining",
              "hard_aborted",
              "inactive"
            ],
            "title": "State"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "reason"
        ],
        "title": "Lifecycle"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "PolicyRules": {
        "properties": {
          "auto_refund_limit_minor": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Auto Refund Limit Minor",
